# Host port for Docker. To expose on the LAN, set HOST_BIND=0.0.0.0.
HOST_BIND=127.0.0.1
FRONTEND_OUT_PORT=3000
# Public NEXT_PUBLIC_* values are embedded at build time; never put secrets there.

# Separate catalog API (also works with static frontend export)
LORDFILM_ORIGIN=https://lordfilmx13.ink
API_HOST=127.0.0.1
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
API_OUT_PORT=3001

# Browser-visible API base URL (build-time for production/static).
# Empty: current page origin with port 3001; set an HTTPS URL or /api-prefix behind proxy.
NEXT_PUBLIC_CATALOG_API_URL=
